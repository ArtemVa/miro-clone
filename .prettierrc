{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "overrides": [
    {
      "files": "apps/web/**",
      "options": {
        "plugins": ["@ianvs/prettier-plugin-sort-imports"],
        "importOrder": [
          "<BUILTIN_MODULES>",
          "^react$",
          "^react-dom(/.*)?$",
          "<THIRD_PARTY_MODULES>",
          "",
          "^@repo/(.*)$",
          "",
          "^@/app(/.*)?$",
          "^@/pages(/.*)?$",
          "^@/widgets(/.*)?$",
          "^@/features(/.*)?$",
          "^@/entities(/.*)?$",
          "^@/core(/.*)?$",
          "^@/shared(/.*)?$",
          "^@/mocks(/.*)?$",
          "",
          "^[.]"
        ],
        "importOrderTypeScriptVersion": "6.0.0"
      }
    }
  ]
}
