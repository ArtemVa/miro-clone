# Все переменные необязательные, значения по умолчанию — в src/shared/config/env/env-schema.ts.
# Переопределить локально: скопировать нужные строки в .env.local (он в .gitignore).
# В клиентский бандл попадают все переменные с префиксом VITE_APP_, секреты сюда не кладём.

VITE_APP_DOMAIN=localhost

# Префикс api. В dev Vite проксирует его на VITE_APP_API_PROXY_TARGET
VITE_APP_API_URL=/api

# true — запросы перехватывает MSW (src/mocks). Обычно включается скриптом dev:mocks
VITE_APP_API_MOCKS=false

# Куда dev-сервер Vite проксирует /api и /ws. Порт — PORT из apps/api/.env
VITE_APP_API_PROXY_TARGET=http://localhost:3000

# DSN проекта в Sentry/GlitchTip. Пусто — мониторинг ошибок выключен
VITE_APP_SENTRY_DSN=
