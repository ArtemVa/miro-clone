# Локально: cp .env.example .env
# На сервере эти переменные задаются в окружении сервера, файл .env туда не копируем.

PORT=3000

# fatal, error, warn, info, debug, trace или silent
LOG_LEVEL=info

# Postgres из docker-compose.yml в корне репозитория
DATABASE_URL=postgresql://app:app@localhost:5432/app
