{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["eslint.config.mjs"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^typecheck", "db:generate"]
    },
    "build": {
      "dependsOn": ["^build", "^typecheck", "db:generate"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^typecheck", "db:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "LOG_LEVEL"],
      "dependsOn": ["db:generate"]
    }
  }
}
